# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=
# Optional proxy/gateway; blank = https://api.anthropic.com
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

POSTGRES_USER=docvault
POSTGRES_PASSWORD=docvault
POSTGRES_DB=docvault

MAX_UPLOAD_MB=100
# Published port when not behind Traefik
DOCVAULT_PORT=8080

# ---- Deployment (scripts/deploy.sh) ----
# Docker context to deploy to (`docker context ls`). Blank = the current context.
DEPLOY_DOCKER_CONTEXT=
# Host directory for the database, uploads and model cache. Blank = Docker named volumes.
DATA_DIR=
# Public hostname served through an existing Traefik. Blank = publish DOCVAULT_PORT instead.
DOCVAULT_HOST=
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=letsencrypt
# Optional comma-separated Traefik middlewares, e.g. my-allowlist@file
TRAEFIK_MIDDLEWARES=
